# Groq free-tier API key from https://console.groq.com/keys
# Paste your own key in a NEW file named .env (not .env.example). Never commit .env.
GROQ_API_KEY=

# GPT-OSS for feedback; Whisper for audio to text.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# groq = cloud Whisper, requires the checkbox before audio is uploaded
# auto = offline Whisper if installed, else Groq only with consent
# whisper = offline Faster-Whisper only; none = manual transcript only
STT_PROVIDER=groq
WHISPER_MODEL=base.en

# Docker Compose overrides APP_DATA_DIR to /data (mounted from ./data).
# Local Python uses ./data. No WAV recordings saved by the app
APP_DATA_DIR=./data
